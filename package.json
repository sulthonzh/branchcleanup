{
  "name": "branchcleanup",
  "version": "1.1.0",
  "description": "Smart Git branch cleanup CLI that detects squash-merged branches with interactive deletion",
  "main": "dist/index.js",
  "bin": {
    "branchcleanup": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
