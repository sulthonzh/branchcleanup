{
  "name": "branchcleanup",
  "version": "1.1.0",
  "description": "Smart Git branch cleanup CLI that detects squash-merged branches with interactive deletion",
  "main": "dist/index.js",
  "bin": {
    "branchcleanup": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "branch",
    "cleanup",
    "cli",
    "github",
    "squash",
    "merge",
    "developer-tools"
  ],
  "author": "Sulthon",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "cli-spinner": "^0.2.10",
    "commander": "^15.0.0",
    "inquirer": "^14.0.0",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulthonzh/branchcleanup.git"
  },
  "homepage": "https://github.com/sulthonzh/branchcleanup",
  "bugs": {
    "url": "https://github.com/sulthonzh/branchcleanup/issues"
  }
